{
  "name": "freellm-ide",
  "version": "0.1.0",
  "description": "A desktop code editor with a built-in AI coding agent that runs on any OpenAI-compatible LLM endpoint — bring your own API key.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Aiden McGraw",
    "email": "aidenmcgraw55@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "ide",
    "code-editor",
    "ai-agent",
    "coding-agent",
    "electron",
    "monaco",
    "openai-compatible",
    "freellmapi",
    "openrouter",
    "ollama",
    "byok"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.31.0",
    "monaco-editor": "^0.56.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^7.1.0",
    "vitest": "^3.1.3",
    "zustand": "^5.0.14"
  }
}
